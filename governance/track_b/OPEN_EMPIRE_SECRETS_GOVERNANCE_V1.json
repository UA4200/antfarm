  "validation_rules": [
    {
      "rule_id": "VR-001",
      "name": "No values in documentation",
      "check": "grep -r 'sk-' ~/.openclaw/workspace/ --include='*.md' --include='*.json' | grep -v secrets/",
      "expected_result": "no matches",
      "severity": "CRITICAL"
    },
    {
      "rule_id": "VR-002",
      "name": "Secrets file not in git",
      "check": "git -C ~/.openclaw/workspace ls-files --error-unmatch secrets/.env 2>&1 | grep 'did not match'",
      "expected_result": "file not tracked",
      "severity": "CRITICAL"
    },
    {
      "rule_id": "VR-003",
      "name": "All CRITICAL keys present in .env",
      "check": "python3 -c \"import os; [print(k) for k in ['ANTHROPIC_API_KEY','KALSHI_API_KEY_ID','OPENCLAW_API_KEY'] if not os.environ.get(k)]\"",
      "expected_result": "empty output",
      "severity": "HIGH"
    },
    {
      "rule_id": "VR-004",
      "name": "Secrets file permissions",
      "check": "stat -f '%Lp' ~/.openclaw/secrets/.env",
      "expected_result": "600",
      "severity": "HIGH"
    }
  ],

