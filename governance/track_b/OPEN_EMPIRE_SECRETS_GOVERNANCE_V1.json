    "governed_by": "Open Empire Constitution v2, Governance Baseline v1.0.0",
    "secret_values_location": "~/.openclaw/secrets/.env (not tracked by git)"
  },

  "policy": {
    "storage_approach": "single-file",
    "secrets_file": "~/.openclaw/secrets/.env",
    "git_policy": "NEVER_COMMIT — .env files are in .gitignore across all repositories",
    "backup_policy": "Manual encrypted backup to operator's secure storage. Not automated.",
    "sharing_policy": "Nathan Asiegbu only. No multi-user access.",
    "rotation_alert_days": 90,
    "rotation_enforcement": "advisory — Telegram alert at 90 days overdue",
    "access_logging": "Not currently implemented — Phase 2 enhancement",
    "vault_integration": "Not implemented — target: HashiCorp Vault or SOPS in Phase 3",
    "environment": "production",
    "allowed_environments": ["production"],
    "prohibited_actions": [
      "Committing secret values to any git repository",
      "Logging secret values to PM2 logs or any observability system",
      "Passing secret values via command-line arguments (use env vars)",
      "Storing secret values in AGENTS.md or any workspace documentation",
      "Sharing secret values via Telegram, Discord, or email"
    ]
  },

  "rotation_schedule": {
    "policy_type": "advisory",
    "check_frequency": "weekly",
    "alert_channel": "telegram",
    "overdue_threshold_days": 90,
    "critical_keys_threshold_days": 60,
    "rotation_runbook": [
      "1. Generate new key/token at provider",
      "2. Update ~/.openclaw/secrets/.env",
      "3. Restart affected PM2 processes: pm2 restart <name>",
      "4. Verify service health at /health endpoint",
      "5. Revoke old key at provider",
      "6. Update last_rotated in this file",
      "7. Commit updated metadata (not values) to governance repo"
    ]
  },

